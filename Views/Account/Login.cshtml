@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Iniciar sesión · FSP Images</title>
    <link rel="stylesheet" href="/css/login.css" />
</head>
<body>
    <main class="l-card">
        <div class="l-mark" aria-hidden="true">
            <svg viewBox="0 0 24 24"
                 width="26"
                 height="26"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="1.8"
                 stroke-linecap="round"
                 stroke-linejoin="round">
                <rect x="3" y="4" width="18" height="16" rx="3" />
                <circle cx="9" cy="10" r="1.6" />
                <path d="M21 16l-5-5-8 8" />
            </svg>
        </div>

        <h1 class="l-title">Iniciar sesión</h1>
        <p class="l-subtitle">Accede para ver la galería.</p>

        <div id="login-error" class="l-error" role="alert" aria-live="polite" hidden>
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="12" r="9" />
                <path d="M12 8v5" />
                <path d="M12 16h.01" />
            </svg>
            <span id="login-error-message"></span>
        </div>

       
        <div class="l-field">
            <label for="username">Usuario</label>
            <input id="username"
                   name="Username"
                   class="l-input"
                   type="text"
                   autocomplete="username"
                   autofocus
                   placeholder="nombre@empresa.com" />
        </div>

        <div class="l-field">
            <label for="password">Contraseña</label>
            <input id="password"
                   name="Password"
                   class="l-input"
                   type="password"
                   autocomplete="current-password" />
        </div>

        <button type="button"
                class="l-submit"
                onclick="Login()">
            Entrar
        </button>

        <p class="l-help">
            ¿Problemas para entrar? Contacta al administrador.
        </p>
    </main>

    <script src="/js/login.js"></script>
</body>
</html>
